<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">闲置守护</string>
    <string name="accessibility_service_label">闲置守护（无障碍）</string>
    <string name="accessibility_service_description">用于检测用户触屏操作（点击/长按）以判断是否闲置，并在触发时执行"回到桌面"。本应用不会读取窗口内容。</string>

    <string name="header_subtitle">"闲置"＝没有任何触屏操作。到点先回桌面，再按"倒计时关闭"强制停止前台App并锁屏。</string>

    <!-- Notification -->
    <string name="notif_channel_name">闲置守护服务</string>
    <string name="notif_title">闲置守护运行中</string>
    <string name="notif_monitoring">闲置 %1$d 分钟 → 回桌面并执行关闭</string>
    <string name="notif_waiting_kill">关闭倒计时进行中（%1$d 分钟），触屏可打断</string>
    <string name="notif_asleep">已清理并锁屏，等你回来恢复监测</string>

    <!-- UI section headers -->
    <string name="section_settings">闲置设置</string>
    <string name="section_permissions">权限授予</string>
    <string name="section_test">测试</string>
    <string name="title_log">触发日志</string>
    <string name="title_auto_start">自启动引导</string>

    <string name="label_enable">启用守护</string>
    <string name="label_idle_minutes">闲置时长（分钟）</string>
    <string name="label_countdown">倒计时关闭（分钟，0=关）</string>
    <string name="hint_countdown">0＝闲置到点后直接 回桌面→杀前台→锁屏；&gt;0＝先回桌面，再等这个倒计时，期间触屏可打断</string>

    <string name="perm_accessibility">无障碍服务</string>
    <string name="perm_device_admin">设备管理器（用于锁屏）</string>
    <string name="perm_device_owner">设备控制者 DeviceOwner（强杀必需）</string>
    <string name="perm_battery">忽略电池优化</string>
    <string name="perm_exact_alarm">精准闹钟（保证到点触发）</string>
    <string name="perm_usage">使用情况访问（识别前台App，清理用）</string>

    <string name="btn_grant">去授予</string>
    <string name="btn_ignore_battery">去设置</string>
    <string name="btn_test_trigger">立即测试触发</string>
    <string name="btn_copy_docmd">复制开通命令</string>

    <string name="device_admin_rationale">闲置守护需要设备管理员权限，以便在触发后自动锁屏（息屏）。</string>
    <string name="device_owner_hint">未开通只能做"轻量清理"，带前台服务的App（如视频）杀不掉。开通方法：手机开USB调试连电脑，复制命令执行，然后在手机上确认弹窗。注意：开通需手机上没有其他账户，且开通后只能再经adb移除。</string>
    <string name="row_auto_start_hint">国产 ROM 请在系统"自启动管理"中允许闲置守护自启动，避免被杀后台。</string>

    <string name="status_line">%1$s  %2$s</string>

    <string name="toast_missing_perms">请先授予：%1$s</string>
    <string name="toast_cant_open_settings">无法跳转到系统设置，请手动前往。</string>
    <string name="toast_test_triggered">已执行一次完整触发：回桌面 → 杀前台 → 锁屏。</string>
    <string name="toast_cmd_copied">命令已复制，去电脑终端粘贴执行（手机需开USB调试并连好）。</string>
